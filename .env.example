# ERP backend (:8000) — copy to `.env` and fill in the blanks.
#
#   cp .env.example .env
#
# `.env` is gitignored and must stay that way: it holds the database password,
# the admin password and the JWT signing key. Never commit the filled-in file.
#
# The chatbot backend has its OWN env file — see chatbot_backend/.env.example.

# --- PostgreSQL -------------------------------------------------------------
# The database must already exist before loading; create_all builds tables, not
# the database itself:  createdb supply_chain_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=supply_chain_db
DB_USER=postgres
DB_PASSWORD=

# --- Seeded admin -----------------------------------------------------------
# Created on first startup if absent. Every row the loaders write is booked
# against this user, so the load fails without it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Auth -------------------------------------------------------------------
# Signs the session cookie. Use a long random string, and a DIFFERENT one per
# environment — sharing it between dev and production means a dev token is
# valid in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# --- Chatbot service --------------------------------------------------------
# Where the ERP proxies /chatbot/* to. Leave as-is unless you moved the
# chatbot backend off :8010.
CHATBOT_BACKEND_URL=http://127.0.0.1:8010

# Base URL of this app's own FastAPI backend (app/) — see src/lib/api/client.ts.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Base URL of the chatbot backend (chatbot_backend/, a separate service) —
# see src/lib/chatbot/api.ts. Defaults to http://127.0.0.1:8010/api if unset.
VITE_CHATBOT_API_BASE_URL=http://127.0.0.1:8010/api

# Base URL of this app's own FastAPI backend (app/) — see src/lib/api/client.ts.
# The chatbot rides on this same origin too, at /chatbot/* (app/chatbot_proxy.py
# forwards it to chatbot_backend/ internally) — one URL for the whole frontend.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Only needed to point the chatbot at something OTHER than this app's own
# /chatbot proxy — e.g. talking to chatbot_backend directly on :8010 while
# developing on it in isolation. Leave unset for normal use.
# VITE_CHATBOT_API_BASE_URL=http://127.0.0.1:8010/api

# Chatbot backend (:8010) — copy to `.env` and fill in the blanks.
#
#   cd chatbot_backend && cp .env.example .env
#
# `.env` is gitignored and must stay that way: it holds the OpenAI key, the
# database password and the JWT signing key. Never commit the filled-in file.
#
# Only the values in the first two sections MUST be set. Everything below them
# already matches the code's defaults and is listed so the knobs are
# discoverable — delete any line you are happy to leave alone.

# --- OpenAI -----------------------------------------------------------------
# Required. The assistant makes 4-5 model calls per question plus one
# embedding, so this key does real work — keep it out of git.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
EMBEDDING_MODEL=text-embedding-3-small
# The Responses API. Leave true unless you switch to an older
# chat-completions-only model.
OPENAI_USE_RESPONSES_API=true
# Unset for reasoning models, which reject it.
# LLM_TEMPERATURE=0

# --- PostgreSQL -------------------------------------------------------------
# The same database the ERP uses. The chatbot only ever READS it.
# Both spellings are read; keep them in sync.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=supply_chain_db
DB_USER=postgres
DB_PASSWORD=

PGHOST=localhost
PGPORT=5432
PGDATABASE=supply_chain_db
PGUSER=postgres
PGPASSWORD=

# --- Auth (shared with the ERP backend) -------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# MUST match the ERP backend's JWT_SECRET_KEY, or a session valid in one
# service is rejected by the other.
JWT_SECRET_KEY=

# --- Model behaviour --------------------------------------------------------
# Effort is the main speed/accuracy lever. Routing and analysis are easy and
# want speed; SQL is where a wrong answer comes from and gets more thinking.
LLM_REASONING_EFFORT=low
LLM_EFFORT_FAST=low
LLM_EFFORT_ACCURATE=medium
# A short timeout is deliberate: it cuts a runaway reasoning call short and the
# retry usually lands faster than letting the first one finish.
LLM_TIMEOUT_S=20
LLM_MAX_RETRIES=2

# --- SQL --------------------------------------------------------------------
# 0 = no row cap. The UI virtualises the table, so every matching row is
# returned and the browser only draws what is on screen.
SQL_ROW_LIMIT=0
SQL_TIMEOUT_MS=30000
SQL_MAX_RETRIES=2

# --- Vector store (business terminology) ------------------------------------
# Local Chroma directory, relative to chatbot_backend/. Re-seeds itself when
# business_terms.py changes.
VECTOR_DIR=.chroma
VECTOR_COLLECTION=supply_chain_knowledge
RAG_TOP_K=4
# Anything beyond this cosine distance is treated as irrelevant, which is what
# triggers the knowledge-inference fallback.
RAG_MAX_DISTANCE=0.65
# An explicit timeout matters here: the default is none, and a dropped idle
# connection then blocks on the OS TCP retransmit — measured at 23 seconds on a
# single embedding call.
EMBEDDING_TIMEOUT_S=10
EMBEDDING_MAX_RETRIES=3

# --- Python compute sandbox -------------------------------------------------
ENABLE_COMPUTE=true
COMPUTE_TIMEOUT_S=10
COMPUTE_MAX_RETRIES=1

# --- Forecasting ------------------------------------------------------------
FORECAST_SEASONAL_PERIODS=12
ENABLE_PROPHET=true

# --- Logging ----------------------------------------------------------------
# Prints every prompt and reply to the console. Very useful while developing,
# noisy in production — set false there.
LOG_LLM=true
LOG_LLM_MAX_CHARS=1000

# --- Loading ----------------------------------------------------------------
# Loading is an explicit CLI, never a startup side effect: running it on every
# start (and every --reload) silently doubled purchases_data.
AUTO_LOAD_ON_STARTUP=false

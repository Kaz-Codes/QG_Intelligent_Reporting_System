# Chatbot backend (:8010) — copy to `.env` and fill in the blanks.
#
#   cp .env.example .env
#
# This file belongs NEXT TO THIS ONE, at chatbot_backend/.env — that is the
# path backend/config.py loads (PROJECT_ROOT = the chatbot_backend folder).
# Putting it at the repo root instead leaves every _required() key unset and
# the service refuses to start.
#
# `.env` is gitignored and must stay that way: it holds the database password
# and the OpenAI key. Never commit the filled-in file.
#
# The ERP backend has its OWN env file at the repo root — see .env.example
# there. The two services are configured separately and BOTH must be set up.
#
#
# ===========================================================================
#  CRITICAL — CORS IS CONFIGURED TWICE, UNDER TWO DIFFERENT NAMES
# ===========================================================================
#
#   The ERP backend reads   ALLOWED_ORIGINS   (repo-root .env)
#   THIS service reads      CORS_ORIGINS      (this file)
#
# They are two names for the same idea and BOTH must be set in a real
# deployment. Setting only one leaves half the application broken.
#
# It fails in the worst possible way: the browser blocks the request before it
# is ever sent, so NOTHING appears in any server log. There is no 500, no
# traceback, no failed request to find — only a CORS error in the browser
# console, on whichever half you forgot. This has already cost an afternoon.
#
# AND THE DEVELOPMENT FALLBACK HIDES IT. This service also accepts any origin
# matching  https?://(localhost|127.0.0.1)(:\d+)?  — see _LOCAL_ORIGIN_REGEX
# in backend/app/main.py. That regex does NOT match a LAN IP. So on a
# developer machine CORS_ORIGINS looks optional, because the regex is quietly
# covering for it; the moment the frontend is served from http://192.168.x.x
# the regex stops matching and CORS_ORIGINS is the only thing left. On a
# deployed host it is doing real work and is NOT optional.
#
# Set both to the origin the BROWSER uses — scheme, host and port, no trailing
# slash. Not the server's own address; the address people type.
#
#     chatbot_backend/.env   CORS_ORIGINS=http://192.168.1.50:5173
#     <repo root>/.env       ALLOWED_ORIGINS=http://192.168.1.50:5173
#
# ===========================================================================

# --- CORS -------------------------------------------------------------------
# Comma-separated. Empty is fine ONLY on a developer machine, where the
# localhost regex above covers it. Required on any deployed host. See above.
CORS_ORIGINS=

# --- OpenAI -----------------------------------------------------------------
# REQUIRED, both of them. config.py guards these with _required(), which
# raises ConfigError at import — the service does not start, it exits with
# "OPENAI_API_KEY is not set. Add it to ...\.env and restart."
OPENAI_API_KEY=
OPENAI_MODEL=

# --- PostgreSQL -------------------------------------------------------------
# The same database the ERP uses. chatbot_messages and chatbot_conversations
# live alongside the ERP's tables but are created and owned by THIS service
# (they are deliberately excluded from the ERP's Alembic migrations).
#
# REQUIRED: DB_HOST, DB_PORT, DB_NAME, DB_USER are all _required() — any one
# missing and the service will not start.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=supply_chain_db
DB_USER=postgres
# OPTIONAL, and the one exception in this block: read with a plain getenv and
# allowed to be blank, because a local trust-auth Postgres legitimately has no
# password. Blank means blank, not "unset".
DB_PASSWORD=

# --- Auth -------------------------------------------------------------------
# Signs and verifies the session cookie, and MUST be byte-identical to the
# ERP's JWT_SECRET_KEY or no user is ever identified — conversations are not
# saved or restored and audit rows have no user, with the only clue being an
# "access_token cookie ... could not be verified" line at startup.
#
# USUALLY LEAVE THIS BLANK. backend/api/identity.py deliberately reads the
# ERP's .env from the repo root above this folder and PREFERS it, so the two
# cannot drift apart. It falls back to the value here only when no ERP .env is
# found above — i.e. a standalone deployment, where it becomes required.
JWT_SECRET_KEY=

# ===========================================================================
#  Everything below is OPTIONAL. Every one has a working default in
#  backend/config.py; leaving the whole block commented out is the normal
#  case. The defaults shown are the ones config.py actually ships.
# ===========================================================================

# --- LLM behaviour ----------------------------------------------------------
# Sent only when explicitly set — some newer models accept only their own
# default temperature and reject anything else. Unset means "do not send it".
# LLM_TEMPERATURE=
#
# Reasoning models reject function tools on /v1/chat/completions, which is what
# structured output needs; the Responses API supports both. Turn off only for a
# model that does not support it.
# OPENAI_USE_RESPONSES_API=true
#
# Retries are PER CALL and the SDK applies the timeout per attempt, so one
# call's worst case is timeout x (retries + 1). A turn makes 4-5 sequential
# calls, so raising either compounds across the whole answer.
# LLM_MAX_RETRIES=2
# LLM_TIMEOUT_S=20
#
# "low" is a deliberate floor: every call here is schema-constrained rather
# than open-ended, and the unset default measured far slower and more variable
# with no accuracy gain.
# LLM_REASONING_EFFORT=low
#
# Per-role overrides of the above. The calls are not equal: classification
# (routing, analysis type) is easy and wants speed, while writing SQL against a
# large schema is where a wrong answer actually comes from and deserves more
# thinking.
# LLM_EFFORT_FAST=low
# LLM_EFFORT_ACCURATE=medium

# --- SQL guardrails ---------------------------------------------------------
# 0 means NO row cap — the user gets every matching row in a scrollable table
# rather than a silent top-100. The real protection against a runaway query is
# the timeout plus the READ ONLY transaction, not this.
# SQL_ROW_LIMIT=0
# SQL_TIMEOUT_MS=30000
# SQL_MAX_RETRIES=2
#
# One extra attempt when a query returns NOTHING, telling the model to question
# its own filters — three real bugs surfaced as a confident "0" rather than an
# error.
# ZERO_ROW_RETRY=true

# --- How much of a result the answering model reads -------------------------
# Budgeted in CHARACTERS, not rows: row size varies by two orders of magnitude
# between a 2-column series and a 46-column consignment.
# LLM_ROW_CHAR_BUDGET=250000
# LLM_ROW_HARD_CAP=5000

# --- Dynamic computation (code interpreter) ---------------------------------
# When on, the assistant may write and RUN Python over query results in a
# guarded sandbox (backend/tools/sandbox.py). This executes LLM-generated code;
# set false to disable code execution entirely.
# ENABLE_COMPUTE=true
# COMPUTE_TIMEOUT_S=10
# COMPUTE_MAX_RETRIES=1

# --- Forecasting ------------------------------------------------------------
# 12 = monthly data with a yearly season. Seasonal models engage only with at
# least 2 full cycles of history, otherwise a linear trend is used.
# FORECAST_SEASONAL_PERIODS=12
# Prophet is heavy and optional; SARIMA via statsmodels is the lighter default.
# Set false to force it off even where it is installed.
# ENABLE_PROPHET=true

# --- Vector store (business terminology / document RAG) ---------------------
# VECTOR_DIR defaults to a .chroma folder inside chatbot_backend/.
# VECTOR_DIR=
# VECTOR_COLLECTION=supply_chain_knowledge
# EMBEDDING_MODEL=text-embedding-3-small
#
# An EXPLICIT embedding timeout, because the default is None: the HTTP pool
# drops an idle connection after ~5s and every turn leaves a longer gap while
# the chat model thinks, so without this the next embed blocks on TCP
# retransmit. Measured 23,498ms after a 10s gap; 1,971ms once set.
# EMBEDDING_TIMEOUT_S=10
# EMBEDDING_MAX_RETRIES=3
# RAG_TOP_K=4
#
# Cosine distance above which a retrieved document counts as unrelated.
# Without a ceiling, nearest-neighbour search always returns something and the
# "knowledge found?" branch could never be false. Re-check with
# tools/check_rag_threshold.py after adding a batch of terms.
# RAG_MAX_DISTANCE=0.65

# --- Learned terminology ----------------------------------------------------
# A term the Knowledge Agent had to infer is saved AFTER it produced a working
# query, for human review. The live file is gitignored and per-machine;
# learned_terms.seed.json is what ships.
# PERSIST_LEARNED=true
# LEARNED_TERMS_PATH=

# --- Query cache ------------------------------------------------------------
# Replays the SQL that answered a question instead of writing a new one. The
# SQL agent produced up to five different queries for one question across five
# runs; replaying makes a repeat question identical by construction.
# ENABLE_QUERY_CACHE=true
# QUERY_CACHE_PATH=
#
# MUCH tighter than RAG_MAX_DISTANCE, because this decides whether to reuse a
# query verbatim, where a near-miss silently answers a different question:
# "stock of resin" and "stock of steel" sit close together in embedding space.
# QUERY_CACHE_MAX_DISTANCE=0.15

# --- Observability ----------------------------------------------------------
# Prints every OpenAI call (messages, answer, token usage) to the terminal with
# a running call counter. Set false to silence.
# LOG_LLM=true
# Per-message character cap so a large schema prompt does not flood the
# terminal. 0 means no truncation.
# LOG_LLM_MAX_CHARS=1000

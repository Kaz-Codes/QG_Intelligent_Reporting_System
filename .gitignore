.env
/venv

# Source workbooks. These are ~169 MB of Excel exports and do not belong in
# git: pushing them is what made the last push time out, and they change every
# time a new period is exported. They must be copied onto a machine separately
# — a fresh clone has none of them, and every loader will find nothing to read.
app/loading/data/

# Compiled Python. 221 of these are currently tracked, which is why unrelated
# .pyc churn shows up in every diff.
__pycache__/
*.py[cod]

# Runtime data, rewritten constantly by whichever machine is running.
# Tracking these made a merge conflict out of ordinary use (and leaked one
# user's taught terms). learned_terms.seed.json IS tracked and seeds a
# fresh install; the live files are rebuilt or grow locally.
chatbot_backend/backend/metadata/query_cache.json
chatbot_backend/backend/metadata/data_profile.json
chatbot_backend/backend/metadata/learned_terms.json
